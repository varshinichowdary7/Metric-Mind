# ─────────────────────────────────────────────────────────────
# MetricMind — environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# ── Local LLM (LM Studio, OpenAI-compatible server) ──
# Start LM Studio's local server and load the models below.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio                       # LM Studio ignores the value, but the OpenAI client requires a non-empty key
LLM_MODEL=qwen/qwen3.8-27b                   # capable model used as the agent / orchestrator
LLM_MODEL_FAST=nvidia/nemotron-3-nano        # small model for cheap classification / routing
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# ── Semantic layer (local Python service; Cube-compatible contract) ──
SEMANTIC_API_URL=http://localhost:4000
SEMANTIC_PORT=4000

# ── Cube.dev semantic layer (optional production swap; see cube/) ──
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_API_SECRET=dev-secret-change-me

# ── Warehouse (DuckDB, local file) ──
DUCKDB_PATH=./data/warehouse.duckdb

# ── MetricMind API (FastAPI) ──
API_HOST=0.0.0.0
API_PORT=8001

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:8001
